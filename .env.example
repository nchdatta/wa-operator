# WhatsApp Operator Mode: copy to .env and fill in.
# Tokens do NOT go here. Store them in Windows Credential Manager with
#   npm run cli -- secret set <NAME>
# for CLAUDE_CODE_OAUTH_TOKEN, WHATSAPP_ACCESS_TOKEN, META_APP_SECRET, META_VERIFY_TOKEN, TELEGRAM_BOT_TOKEN.

# whatsapp (default) or telegram (fallback if Meta's AI policy tightens)
CHANNEL=whatsapp

# --- The one user ---
# Owner's personal WhatsApp number, digits only with country code
OPERATOR_WA_ID=8801700000000
# Folders Claude may change files in (comma separated). Reads elsewhere need a tap.
OPERATOR_ROOTS=%USERPROFILE%\Documents\Shop,D:\
# Claude's working folder (defaults to the first root)
# OPERATOR_HOME=
# OPERATOR_INBOX=        (default <home>\Operator Inbox)
# OPERATOR_OUTBOX=       (default <home>\Operator Outbox)
OPERATOR_IDLE_MIN=30
OPERATOR_MODEL=opus
OPERATOR_MAX_TURNS=40
OPERATOR_APPROVAL_TTL_SECONDS=300
# Extra paths that are always blocked (comma separated)
# OPERATOR_EXTRA_DENY=C:\Finance\Private

# --- Business (scope guard) ---
BUSINESS_NAME=Rahim Fashion
BUSINESS_DESCRIPTION=clothing shop in Mirpur, Dhaka
BUSINESS_TIMEZONE=Asia/Dhaka

# --- WhatsApp Cloud API (dedicated number in its own WhatsApp Business Account) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v24.0
# Published PIN Flow (config/flows/pin-flow.json)
OPERATOR_PIN_FLOW_ID=
# Approved utility template asking the owner to reply (used only after the 24-hour window closes)
OPERATOR_REPLY_TEMPLATE=operator_result_ready
OPERATOR_REPLY_TEMPLATE_LANG=en

# --- Telegram fallback (CHANNEL=telegram) ---
# TELEGRAM_OPERATOR_USER_ID=

# --- Optional: real voice notes through a local whisper.cpp server ---
# WHISPER_URL=http://127.0.0.1:8178

# --- Service ---
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=3100
WEBHOOK_PATH=/webhooks/whatsapp
DATA_DIR=./data
LOG_LEVEL=info
LOG_FILE=./logs/operator.log
