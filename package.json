{
  "name": "wa-operator",
  "version": "0.1.2",
  "private": true,
  "description": "WhatsApp Operator Mode: a human-in-the-loop AI agent; the business owner drives Claude on the shop PC from one dedicated WhatsApp number",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "wa-operator": "dist/bin/cli.js",
    "wa-operator-svc": "dist/bin/service.js"
  },
  "scripts": {
    "setup": "tsx src/bin/setup.ts",
    "uninstall": "tsx src/bin/uninstall.ts",
    "start": "tsx src/bin/control.ts start",
    "stop": "tsx src/bin/control.ts stop",
    "restart": "npm run build && tsx src/bin/control.ts restart",
    "status": "tsx src/bin/control.ts status",
    "logs": "tsx src/bin/control.ts logs",
    "doctor": "tsx src/bin/cli.ts doctor",
    "cli": "tsx src/bin/cli.ts",
    "dev": "tsx src/bin/service.ts",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "check": "tsc --noEmit && eslint . && vitest run"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.296",
    "@node-rs/argon2": "^2.2.2",
    "baileys": "^7.0.0-rc14",
    "better-sqlite3": "npm:better-sqlite3-multiple-ciphers@^13.0.3",
    "commander": "^15.0.0",
    "dotenv": "^18.0.7",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "shell-quote": "^1.12.0",
    "ulid": "^3.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/shell-quote": "^1.7.5",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
