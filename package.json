{
  "name": "wa-operator",
  "version": "0.1.0",
  "private": true,
  "description": "WhatsApp Operator Mode: the business owner drives Claude on the shop PC from one dedicated WhatsApp number",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "wa-operator": "dist/bin/cli.js",
    "wa-operator-svc": "dist/bin/service.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx src/bin/service.ts",
    "start": "node dist/bin/service.js",
    "cli": "tsx src/bin/cli.ts",
    "db:generate": "drizzle-kit generate",
    "format": "prettier --write .",
    "setup": "tsx src/bin/setup.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.296",
    "@node-rs/argon2": "^2.2.2",
    "better-sqlite3": "^13.0.3",
    "commander": "^15.0.0",
    "dotenv": "^18.0.7",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "pino": "^10.4.0",
    "shell-quote": "^1.12.0",
    "ulid": "^3.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/shell-quote": "^1.7.5",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
